import os
import re
from typing import List, Dict, Any
from pypdf import PdfReader

def parse_markdown(file_path: str) -> str:
    """Reads a markdown file and returns its content."""
    with open(file_path, 'r', encoding='utf-8') as f:
        return f.read()

def parse_pdf(file_path: str) -> str:
    """Extracts text from a PDF file using pypdf."""
    reader = PdfReader(file_path)
    text = ""
    for page in reader.pages:
        text += page.extract_text() + "\n"
    return text

def chunk_document(content: str, doc_id: str, doc_title: str) -> List[Dict[str, Any]]:
    """
    Chunks document content using a heading-aware strategy.
    Splits by Markdown headers (#, ##). If a section > 400 words,
    uses a sliding window approach.
    """
    # Regex to split by # or ## headers, keeping the headers in the result
    # This splits the content into sections starting with headers
    sections = re.split(r'(^#+ .*$)', content, flags=re.MULTILINE)

    # Reconstruct sections: [header, text, header, text, ...]
    structured_sections = []
    if sections:
        # If the first element is not a header, it's the preamble
        if not sections[0].startswith('#'):
            structured_sections.append(("General", sections[0]))
            start_idx = 1
        else:
            start_idx = 0

        for i in range(start_idx, len(sections), 2):
            header = sections[i].strip()
            text = sections[i+1].strip() if i+1 < len(sections) else ""
            structured_sections.append((header, text))

    chunks = []
    chunk_count = 0

    for section_title, section_text in structured_sections:
        words = section_text.split()

        if len(words) <= 400:
            # Section fits in one chunk
            chunk_count += 1
            chunks.append({
                "chunk_id": f"{doc_id}_{chunk_count}",
                "doc_id": doc_id,
                "doc_title": doc_title,
                "section": section_title,
                "text": section_text
            })
        else:
            # Section too large, use sliding window
            # Window size: 400 words, Overlap: 50 words
            window_size = 400
            overlap = 50

            for start in range(0, len(words), window_size - overlap):
                chunk_count += 1
                end = start + window_size
                window_words = words[start:end]
                window_text = " ".join(window_words)

                chunks.append({
                    "chunk_id": f"{doc_id}_{chunk_count}",
                    "doc_id": doc_id,
                    "doc_title": doc_title,
                    "section": f"{section_title} (Part {chunk_count})",
                    "text": window_text
                })

                if end >= len(words):
                    break

    return chunks

def load_and_parse_policies(policies_dir: str = "data/policies") -> List[Dict[str, Any]]:
    """
    Scans the policies directory, processes all .md and .pdf files,
    and returns a complete list of structured chunks.
    """
    if not os.path.exists(policies_dir):
        print(f"Warning: Directory {policies_dir} does not exist.")
        return []

    all_chunks = []

    for filename in os.listdir(policies_dir):
        file_path = os.path.join(policies_dir, filename)
        doc_id = os.path.splitext(filename)[0]
        doc_title = filename

        try:
            if filename.endswith('.md'):
                content = parse_markdown(file_path)
            elif filename.endswith('.pdf'):
                content = parse_pdf(file_path)
            else:
                continue

            chunks = chunk_document(content, doc_id, doc_title)
            all_chunks.extend(chunks)

        except Exception as e:
            print(f"Error processing {filename}: {e}")

    return all_chunks
